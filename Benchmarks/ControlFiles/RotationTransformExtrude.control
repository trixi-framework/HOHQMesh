%
% Exercises the 2D ROTATION_TRANSFORM block. In 2D this is a rigid 3D
% rotation about the point "translation" (it does NOT translate) that turns
% the mesh normal (the z axis) onto "direction". Here the unit-circle mesh is
% tilted 45 degrees about the x axis and then extruded along z, so each hex
% is sheared and its volume is cos(45 deg) times that of the untilted mesh.
% The 3D statistics are computed after the transform, so the benchmark data
% checks the rotation.
%
\begin{CONTROL_INPUT}

   \begin{RUN_PARAMETERS}
      mesh file name   = Benchmarks/MeshFiles/Tests/RotationTransformExtrude.mesh
      plot file name   = Benchmarks/PlotFiles/Tests/RotationTransformExtrude.tec
      stats file name  = none
      test file name   = Benchmarks/BenchmarkData/RotationTransformExtrude.txt
      mesh file format = ISM
      polynomial order = 3
      plot file format = skeleton
   \end{RUN_PARAMETERS}

   \begin{BACKGROUND_GRID}
      background grid size = [0.25, 0.25, 0.0]
   \end{BACKGROUND_GRID}

   \begin{ROTATION_TRANSFORM}
      translation = [0.0, 0.0, 0.0]
      direction   = [0.0, 0.70710678118654752, 0.70710678118654752]
   \end{ROTATION_TRANSFORM}

   \begin{SIMPLE_EXTRUSION}
      direction          = 3
      height             = 1.0
      subdivisions       = 2
      start surface name = bottom
      end surface name   = top
   \end{SIMPLE_EXTRUSION}

   \begin{SPRING_SMOOTHER}
      smoothing            = ON
      smoothing type       = LinearAndCrossBarSpring
      number of iterations = 15
   \end{SPRING_SMOOTHER}

\end{CONTROL_INPUT}

\begin{MODEL}

   \begin{OUTER_BOUNDARY}
      \begin{PARAMETRIC_EQUATION_CURVE}
         name = circle
         xEqn = x(t) = cos(2*pi*t)
         yEqn = y(t) = sin(2*pi*t)
         zEqn = z(t) = 0.0
      \end{PARAMETRIC_EQUATION_CURVE}
   \end{OUTER_BOUNDARY}

\end{MODEL}

\end{FILE}
