%
% Sweeps a circle along a planar quarter-circle arc WITHOUT the
% "algorithm = Hanson" line, so the default (Frenet frame) sweep transform is
% used. The default sweep does not correct for rotation of the frame, so it is
% meant for sweep curves that stay in a plane, like this one. The cross section
% is also scaled from 1 to 0.5 along the sweep.
%
\begin{CONTROL_INPUT}

   \begin{RUN_PARAMETERS}
      mesh file name   = Benchmarks/MeshFiles/Tests/DefaultSweep.mesh
      plot file name   = Benchmarks/PlotFiles/Tests/DefaultSweep.tec
      stats file name  = none
      test file name   = Benchmarks/BenchmarkData/DefaultSweep.txt
      mesh file format = ISM
      polynomial order = 3
      plot file format = skeleton
   \end{RUN_PARAMETERS}

   \begin{BACKGROUND_GRID}
      background grid size = [0.25, 0.25, 0.25]
   \end{BACKGROUND_GRID}

   \begin{SWEEP_ALONG_CURVE}
      subdivisions per segment = 8
      start surface name       = bottom
      end surface name         = top
   \end{SWEEP_ALONG_CURVE}

   \begin{SPRING_SMOOTHER}
      smoothing            = ON
      smoothing type       = LinearAndCrossBarSpring
      number of iterations = 15
   \end{SPRING_SMOOTHER}

\end{CONTROL_INPUT}

\begin{MODEL}

   \begin{OUTER_BOUNDARY}
      \begin{PARAMETRIC_EQUATION_CURVE}
         name = circle
         xEqn = x(t) = cos(2*pi*t)
         yEqn = y(t) = sin(2*pi*t)
         zEqn = z(t) = 0.0
      \end{PARAMETRIC_EQUATION_CURVE}
   \end{OUTER_BOUNDARY}

   \begin{SWEEP_CURVE}
      \begin{PARAMETRIC_EQUATION_CURVE}
         name = bend
         xEqn = x(t) = 3.0*(1.0 - cos(0.5*pi*t))
         yEqn = y(t) = 0.0
         zEqn = z(t) = 3.0*sin(0.5*pi*t)
      \end{PARAMETRIC_EQUATION_CURVE}
   \end{SWEEP_CURVE}

   \begin{SWEEP_SCALE_FACTOR}
      \begin{PARAMETRIC_EQUATION}
         eqn = r(t) = 1.0 - 0.5*t
      \end{PARAMETRIC_EQUATION}
   \end{SWEEP_SCALE_FACTOR}

\end{MODEL}

\end{FILE}
